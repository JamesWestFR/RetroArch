+
+/* Growable list of paths, used while scanning a single directory.
+ * Heap allocated: the former per-directory stack arrays took 1 MB per
+ * recursion level and overflowed with more than 1024 entries. */
+typedef struct {
+    char **items;
+    int    count;
+    int    cap;
+} path_list_t;
+
+static void path_list_push(path_list_t *l, const char *s)
+{
+    if (l->count == l->cap) {
+        int new_cap = l->cap ? l->cap * 2 : 64;
+        char **n = (char **)realloc(l->items, (size_t)new_cap * sizeof(char *));
+        if (!n) { fprintf(stderr, "pkg: out of memory\n"); exit(1); }
+        l->items = n;
+        l->cap   = new_cap;
+    }
+    l->items[l->count] = strdup(s);
+    if (!l->items[l->count]) { fprintf(stderr, "pkg: out of memory\n"); exit(1); }
+    l->count++;
+}
+
+static void path_list_free(path_list_t *l)
+{
+    for (int i = 0; i < l->count; i++)
+        free(l->items[i]);
+    free(l->items);
+    l->items = NULL;
+    l->count = l->cap = 0;
+}
 
