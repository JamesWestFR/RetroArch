+static pkg_file_entry_t *new_file_entry(void)
+{
+    if (g_file_count == g_file_cap) {
+        int new_cap = g_file_cap ? g_file_cap * 2 : 256;
+        pkg_file_entry_t *n = (pkg_file_entry_t *)realloc(g_files,
+                (size_t)new_cap * sizeof(*n));
+        if (!n) {
+            fprintf(stderr, "pkg: out of memory (%d entries)\n", g_file_count);
+            exit(1);
+        }
+        g_files    = n;
+        g_file_cap = new_cap;
+    }
+    pkg_file_entry_t *e = &g_files[g_file_count++];
+    memset(e, 0, sizeof(*e));
+    return e;
